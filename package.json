{
  "name": "rosheta-pro",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-tests.mjs && node --test \"scripts/.tests/*.mjs\" \"scripts/*.test.mjs\"",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check:packaging": "node scripts/check-packaging.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.63.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "main": "electron/main.cjs"
}
